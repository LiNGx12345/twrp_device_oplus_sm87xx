<manifest version="8.0" type="framework">
    <!--
        Recovery HAL manifest.

        In a __ANDROID_RECOVERY__ build, servicemanager only validates AIDL
        addService() calls against VintfObjectRecovery's *recovery* manifest,
        which is read from /system/etc/vintf/manifest.xml (this file) plus
        /system/etc/vintf/manifest/*.xml. /vendor/etc/vintf/ is NOT consulted.

        An empty manifest therefore rejects every AIDL HAL registration:
        gatekeeper aborts (Check failed: status == STATUS_OK), keymint never
        publishes IKeyMintDevice/default, keystore2 loops on "Cannot connect to
        Keymint", and metadata (DE) decryption of /data fails with
        "Unable to decrypt metadata encryption" because the wrapped key cannot
        be unwrapped. Declare the HALs recovery actually uses.
    -->
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <version>1</version>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>3</version>
        <fqname>IKeyMintDevice/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>3</version>
        <fqname>IRemotelyProvisionedComponent/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.secureclock</name>
        <fqname>ISecureClock/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.sharedsecret</name>
        <fqname>ISharedSecret/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.health</name>
        <version>3</version>
        <fqname>IHealth/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.boot</name>
        <fqname>IBootControl/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.vibrator</name>
        <version>2</version>
        <fqname>IVibrator/default</fqname>
    </hal>
    <!--
        OPLUS touch HAL (device side declares it in
        /vendor/odm/etc/vintf/manifest/manifest_touch_aidl.xml, which recovery
        never reads). Without this entry the HAL's addService() is rejected:
            "Could not find vendor.oplus.hardware.touch.IOplusTouch/default in
             the VINTF manifest"
        followed by "Check failed: status == STATUS_OK" and SIGABRT. init then
        restarts the service every ~5 s; each restart re-initialises the touch
        IC (syna_enable_hbp_mode / TCM reset), which shows up as laggy touch
        input while tapping quickly. Declare it here so it registers once.
    -->
    <hal format="aidl">
        <name>vendor.oplus.hardware.touch</name>
        <version>2</version>
        <fqname>IOplusTouch/default</fqname>
    </hal>
</manifest>
